# MQTT broker address used inside Docker Compose
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Dedicated account for the Python telemetry service
MQTT_USERNAME=telemetry-service
MQTT_PASSWORD=replace-with-local-password

# MQTT client configuration
MQTT_CLIENT_ID=microhydros-telemetry-service
MQTT_KEEPALIVE_SECONDS=60
